{
    "version": 7,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 27,
        "patch": 0
    },
    "include": [],
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "HEPCE_BUILD_PIC": "ON",
                "HEPCE_BUILD_BENCH": "OFF",
                "HEPCE_BUILD_WARNINGS": "ON",
                "HEPCE_SYSTEM_INCLUDES": "OFF",
                "HEPCE_NO_EXCEPTIONS": "OFF",
                "HEPCE_BUILD_EXECUTABLE": "ON"
            }
        },
        {
            "name": "shared",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/shared",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "static",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/static",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HEPCE_BUILD_TESTS": "ON",
                "HEPCE_INSTALL": "OFF",
                "HEPCE_CALCULATE_COVERAGE": "ON"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "HEPCE_BUILD_TESTS": "OFF",
                "HEPCE_INSTALL": "ON",
                "HEPCE_BUILD_DOCS": "ON",
                "HEPCE_CALCULATE_COVERAGE": "OFF"
            }
        },
        {
            "name": "strict",
            "hidden": true,
            "cacheVariables": {
                "HEPCE_STOP_ON_WARNINGS": "ON"
            }
        },
        {
            "name": "debug-shared",
            "displayName": "Configure a Debug Shared Library",
            "description": "Target a linux distro to create a debuggable shared library",
            "inherits": [
                "base",
                "debug",
                "shared"
            ]
        },
        {
            "name": "debug-static",
            "displayName": "Configure a Debug Static Library",
            "description": "Target a linux distro to create a debuggable static library",
            "inherits": [
                "base",
                "debug",
                "static"
            ]
        },
        {
            "name": "release-shared",
            "displayName": "Configure a Release Shared Library (Non-Strict)",
            "description": "Target a linux distro to create a release shared library",
            "inherits": [
                "base",
                "release",
                "shared"
            ]
        },
        {
            "name": "release-static",
            "displayName": "Configure a Release Static Library (Non-Strict)",
            "description": "Target a linux distro to create a release static library",
            "inherits": [
                "base",
                "release",
                "static"
            ]
        },
        {
            "name": "release-shared-strict",
            "displayName": "Configure a Release Shared Library (Strict)",
            "description": "Target a linux distro to create a release shared library",
            "inherits": [
                "base",
                "release",
                "strict",
                "shared"
            ]
        },
        {
            "name": "release-static-strict",
            "displayName": "Configure a Release Static Library (Strict)",
            "description": "Target a linux distro to create a release static library",
            "inherits": [
                "base",
                "release",
                "strict",
                "static"
            ]
        },
        {
            "name": "benchmark-static",
            "displayName": "Configure a Benchmarking Executable",
            "description": "Target a linux distro to build release benchmark artifacts",
            "inherits": [
                "base",
                "release",
                "static"
            ],
            "cacheVariables": {
                "HEPCE_BUILD_BENCH": "ON",
                "HEPCE_BUILD_DOCS": "OFF",
                "HEPCE_INSTALL": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "hidden": true,
            "jobs": 4
        },
        {
            "name": "release-shared",
            "displayName": "Shared Release Build (Non-Strict)",
            "inherits": "base",
            "configurePreset": "release-shared"
        },
        {
            "name": "release-static",
            "displayName": "Static Release Build (Non-Strict)",
            "inherits": "base",
            "configurePreset": "release-static"
        },
        {
            "name": "release-shared-strict",
            "description": "Shared Release Build (Strict)",
            "inherits": "base",
            "configurePreset": "release-shared-strict"
        },
        {
            "name": "release-static-strict",
            "description": "Static Release Build (Strict)",
            "inherits": "base",
            "configurePreset": "release-static-strict"
        },
        {
            "name": "debug-shared",
            "displayName": "Shared Release Build",
            "inherits": "base",
            "configurePreset": "debug-shared"
        },
        {
            "name": "debug-static",
            "displayName": "Static Release Build",
            "inherits": "base",
            "configurePreset": "debug-static"
        },
        {
            "name": "benchmark",
            "displayName": "Benchmark Build",
            "inherits": "base",
            "configurePreset": "benchmark-static"
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": {
                "verbosity": "verbose",
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "hepce_*"
                }
            }
        },
        {
            "name": "debug-shared",
            "displayName": "Test the Debug Shared Library",
            "description": "Enable output and stop on failure",
            "inherits": "base",
            "configurePreset": "debug-shared"
        },
        {
            "name": "debug-static",
            "displayName": "Test the Debug Static Library",
            "description": "Enable output and stop on failure",
            "inherits": "base",
            "configurePreset": "debug-static"
        }
    ],
    "packagePresets": [
        {
            "name": "zip",
            "hidden": true,
            "generators": [
                "TGZ"
            ]
        },
        {
            "name": "debian",
            "inherits": "zip",
            "hidden": true,
            "generators": [
                "DEB"
            ]
        },
        {
            "name": "rpm",
            "inherits": "zip",
            "hidden": true,
            "generators": [
                "RPM"
            ]
        },
        {
            "name": "nsis",
            "inherits": "zip",
            "hidden": true,
            "generators": [
                "NSIS"
            ]
        },
        {
            "name": "release-shared-debian",
            "displayName": "Package a Release Shared Library for Debian",
            "inherits": "debian",
            "configurePreset": "release-shared"
        },
        {
            "name": "release-static-debian",
            "displayName": "Package a Release Static Library for Debian",
            "inherits": "debian",
            "configurePreset": "release-static"
        },
        {
            "name": "release-shared-rpm",
            "displayName": "Package a Release Shared Library for RPM",
            "inherits": "rpm",
            "configurePreset": "release-shared"
        },
        {
            "name": "release-static-rpm",
            "displayName": "Package a Release Static Library for RPM",
            "inherits": "rpm",
            "configurePreset": "release-static"
        },
        {
            "name": "release-shared-nsis",
            "displayName": "Package a Release Shared Library for NSIS",
            "inherits": "nsis",
            "configurePreset": "release-shared"
        },
        {
            "name": "release-static-nsis",
            "displayName": "Package a Release Static Library for NSIS",
            "inherits": "nsis",
            "configurePreset": "release-static"
        },
        {
            "name": "release-shared-strict-debian",
            "displayName": "Package a Shared Release for Debian (Strict)",
            "inherits": "debian",
            "configurePreset": "release-shared-strict"
        },
        {
            "name": "release-static-strict-debian",
            "displayName": "Package a Static Release for Debian (Strict)",
            "inherits": "debian",
            "configurePreset": "release-static-strict"
        },
        {
            "name": "release-shared-strict-rpm",
            "displayName": "Package a Shared Release for RPM (Strict)",
            "inherits": "rpm",
            "configurePreset": "release-shared-strict"
        },
        {
            "name": "release-static-strict-rpm",
            "displayName": "Package a Static Release for RPM (Strict)",
            "inherits": "rpm",
            "configurePreset": "release-static-strict"
        },
        {
            "name": "release-shared-strict-nsis",
            "displayName": "Package a Shared Release for NSIS (Strict)",
            "inherits": "nsis",
            "configurePreset": "release-shared-strict"
        },
        {
            "name": "release-static-strict-nsis",
            "displayName": "Package a Static Release for NSIS (Strict)",
            "inherits": "nsis",
            "configurePreset": "release-static-strict"
        }
    ],
    "workflowPresets": [
        {
            "name": "debug-shared",
            "displayName": "Build and Test a Shared Library in Debugging Mode",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug-shared"
                },
                {
                    "type": "build",
                    "name": "debug-shared"
                },
                {
                    "type": "test",
                    "name": "debug-shared"
                }
            ]
        },
        {
            "name": "debug-static",
            "displayName": "Build and Test a Static Library in Debugging Mode",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug-shared"
                },
                {
                    "type": "build",
                    "name": "debug-shared"
                },
                {
                    "type": "test",
                    "name": "debug-shared"
                }
            ]
        },
        {
            "name": "benchmark",
            "displayName": "Build and Run HEP-CE Benchmarking",
            "steps": [
                {
                    "type": "configure",
                    "name": "benchmark-static"
                },
                {
                    "type": "build",
                    "name": "benchmark"
                }
            ]
        }
    ]
}