#-------------------------------------------------------------------------------
# CPack Project Variables
#-------------------------------------------------------------------------------
set(CPACK_PROJECT_URL "https://github.com/SyndemicsLab/hep-ce")

#-------------------------------------------------------------------------------
# CPack Package Variables
#-------------------------------------------------------------------------------
set(CPACK_PACKAGE_NAME @PROJECT_NAME@)
set(CPACK_PACKAGE_VENDOR "Syndemics Lab at Boston Medical Center")
set(CPACK_PACKAGE_CONTACT "Benjamin Linas <Benjamin.Linas@bmc.org>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A microsimulation model studying various cost impacts in the care cascade for Hepatitis C.")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE.txt")

set(CPACK_PACKAGE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(CPACK_PACKAGE_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(CPACK_PACKAGE_VERSION_PATCH @PROJECT_VERSION_PATCH@)
set(CPACK_PACKAGE_VERSION @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@)

#-------------------------------------------------------------------------------
# CPack Components
#-------------------------------------------------------------------------------
set(CPACK_COMPONENT_hepce_library_DISPLAY_NAME "HEPCE Library")
set(CPACK_COMPONENT_hepce_library_DESCRIPTION "HEPCE library, headers, and CMake package files.")
set(CPACK_COMPONENT_hepce_executable_DISPLAY_NAME "HEPCE Executable")
set(CPACK_COMPONENT_hepce_executable_DESCRIPTION "HEPCE executable.")
set(CPACK_COMPONENT_hepce_executable_DEPENDS hepce_library)
set(CPACK_COMPONENTS_ALL hepce_library hepce_executable)

set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_DEB_COMPONENT_INSTALL ON)
set(CPACK_DEBIAN_ENABLE_COMPONENT_DEPENDS ON)
set(CPACK_RPM_COMPONENT_INSTALL ON)

#-------------------------------------------------------------------------------
# CPack RPM Variables
#-------------------------------------------------------------------------------
set(CPACK_RPM_PACKAGE_LICENSE "AGPLv3")
set(CPACK_RPM_PACKAGE_GROUP "Development/Libraries")
set(CPACK_RPM_PACKAGE_URL ${CPACK_PROJECT_URL})
set(CPACK_RPM_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION_SUMMARY}")
set(CPACK_RPM_PACKAGE_NAME "${CPACK_PACKAGE_NAME}")
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)

#-------------------------------------------------------------------------------
# CPack Debian Variables
#-------------------------------------------------------------------------------
set(CPACK_DEBIAN_PACKAGE_SECTION "libs")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE ${CPACK_PROJECT_URL})
set(CPACK_DEBIAN_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION_SUMMARY}")
set(CPACK_DEBIAN_PACKAGE_NAME "${CPACK_PACKAGE_NAME}")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
