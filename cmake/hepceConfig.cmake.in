@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# PACKAGE_PREFIX_DIR works in 3.27+ because it isn't changed before this
if(@HEPCE_BUNDLE_DEPENDENCIES@)
	list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
endif()

find_dependency(Boost REQUIRED)
find_dependency(SQLiteCpp REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(OpenMP REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/hepceTargets.cmake")
